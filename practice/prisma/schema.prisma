// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  admin
  user
}

model User {
  id             Int             @id @default(autoincrement())
  email          String          @unique
  role           UserRole        @default(user)
  name           String          @default("")
  hashedPassword String          @map("hashed_password")
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  projects       Project[]
  memberships    ProjectMember[]
  assignedTasks  Task[]
  refreshTokens  RefreshToken[]

  @@map("users")
}

model Project {
  id                  Int             @id @default(autoincrement())
  name                String
  description         String
  userId              Int             @map("user_id")
  user                User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt           DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  tasks               Task[]
  labels              Label[]
  members             ProjectMember[]
  outgoingActivities  Activity[]      @relation("fromProject")
  incommingActivities Activity[]      @relation("toProject")

  @@index([userId])
  @@map("projects")
}

enum TaskStatus {
  todo
  in_progress
  done
}

enum Priority {
  low
  medium
  high
}

model Task {
  id          Int         @id @default(autoincrement())
  title       String
  priority    Priority
  status      TaskStatus
  assigneeId  Int?        @map("assignee_id")
  completedAt DateTime?   @map("completed_at") @db.Timestamptz(3)
  dueDate     DateTime?   @map("due_date") @db.Timestamptz(3)
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  projectId   Int         @map("project_id")
  project     Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  taskLabel   TaskLabel[]
  assignee    User?       @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
  activities  Activity[]

  @@index([projectId])
  @@index([assigneeId])
  @@map("tasks")
}

model Label {
  id         Int         @id @default(autoincrement())
  name       String
  color      String
  projectId  Int         @map("project_id")
  project    Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  taskLabels TaskLabel[]

  @@unique([projectId, name])
  @@map("labels")
}

enum Role {
  owner
  member
}

model ProjectMember {
  id        Int     @id @default(autoincrement())
  projectId Int     @map("project_id")
  userId    Int     @map("user_id")
  role      Role
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, projectId])
  @@index([projectId])
  @@map("project_members")
}

model TaskLabel {
  id      Int   @id @default(autoincrement())
  taskId  Int   @map("task_id")
  labelId Int   @map("label_id")
  task    Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  label   Label @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@unique([taskId, labelId])
  @@index([labelId])
  @@map("task_labels")
}

model Activity {
  id            Int      @id @default(autoincrement())
  taskId        Int      @map("task_id")
  fromProjectId Int      @map("from_project_id")
  toProjectId   Int      @map("to_project_id")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  task        Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  fromProject Project @relation("fromProject", fields: [fromProjectId], references: [id], onDelete: Cascade)
  toProject   Project @relation("toProject", fields: [toProjectId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@map("activities")
}

model RefreshToken {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @default(dbgenerated("(NOW() + INTERVAL '7 days')")) @map("expires_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
  @@index([userId])
}
